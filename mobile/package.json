{
  "name": "zhetysu-go-mobile",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{App.tsx,src/**/*.{ts,tsx}}\"",
    "lint:fix": "eslint \"{App.tsx,src/**/*.{ts,tsx}}\" --fix",
    "format": "prettier --write \"{App.tsx,src/**/*.{ts,tsx,js,json}}\"",
    "format:check": "prettier --check \"{App.tsx,src/**/*.{ts,tsx,js,json}}\"",
    "test": "node -e \"console.log('No automated mobile tests yet')\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "axios": "^1.6.0",
    "babel-preset-expo": "~55.0.8",
    "dotenv": "^17.3.1",
    "expo": "~55.0.28",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.22",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.7.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native-community/cli-server-api": "^11.4.1",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.4.0"
  }
}
