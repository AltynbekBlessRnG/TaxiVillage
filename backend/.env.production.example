APP_REVIEW_PHONES=
APP_REVIEW_PASSWORD=use_a_unique_12_plus_character_password
APP_REVIEW_PASSENGER_PHONE=+77000000001
APP_REVIEW_DRIVER_PHONE=+77000000002
APP_REVIEW_MERCHANT_PHONE=+77000000003
