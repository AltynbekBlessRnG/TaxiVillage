APP_ORIGIN=https://taxivillage-admin.onrender.com
PUBLIC_BASE_URL=https://taxivillage-backend.onrender.com
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=45
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username
